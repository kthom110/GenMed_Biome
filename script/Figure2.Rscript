## Add Panel Labels ----

#grab letters for panels
panel.labs = LETTERS[2:6]

#grab plots we want to add letters to
toaddlabs = plt.da.list

#add letters and adjust margins where needed
withlabs = lapply(1:length(toaddlabs), function(i){
  plt.tmp = toaddlabs[[i]]
  lab.tmp = panel.labs[i]
  plt.tmp = plt.tmp +
    labs(tag = lab.tmp) +
    theme(plot.margin = margin(l = 3, b = 0, r = 0, t = 0, unit = "mm"),
          plot.tag = element_text(size = 10, hjust = 1, vjust = 1),
          plot.tag.location = "plot", 
          plot.tag.position = c(0,1))
  return(plt.tmp)
})


# Legends ----

## Beta Diversity Plot Legend ----

### Set Up ----

df.beta = data.frame(
  x = rep(1, times = 2),
  y = factor(c(1:2), levels = 1:2, ordered=T),
  fill.col = factor(c("Primary", "Metastatic"), ordered = T, levels = c("Primary", "Metastatic", "p < 0.05")))

df.asterisk = data.frame(
  x = rep(1, times = 1),
  y = factor(c(1), levels = 1, ordered=T),
  fill.col = factor(c("p < 0.05"), ordered = T, levels = c("Primary", "Metastatic", "p < 0.05")))

### Dummy Plot ----
# dummy.legend.beta = ggplot(df.beta, aes(x = x, y = y, color = fill.col)) + 
#   geom_point(size = 1) + scale_color_manual(values = c("#6551CCFF", "#BFB2FFFF")) + theme_bw()

dummy.legend.beta = ggplot() + 
  geom_point(data = df.beta, aes(x = x, y = y, color = fill.col), size = 1, shape = 19) +
  geom_point(data = df.asterisk, aes(x = x, y = y, color = fill.col), size = 2, shape = "\u273B") +
  #scale_color_manual(values = c("#6551CCFF", "#BFB2FFFF", "black")) +
scale_color_manual(values = c("#98ab76", "#c62320", "black")) +
  theme_bw()

### Format ----
dummy.format.legend.beta = dummy.legend.beta + 
  theme(legend.title = element_blank(),
        legend.text = element_text(size = 10, margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm")),  # size= 6
        legend.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm"),
        legend.box.spacing = unit(0, "mm"),
        legend.box.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm"),
        legend.key.height = unit(3, "mm"),
        legend.key.width = unit(4, "mm")) 
dummy.format.legend.beta

### Extract Legend ----

#grab legend
legend.beta = dummy.format.legend.beta %>% 
  get_legend()
legend.beta = legend.beta %>% 
  as_ggplot()

#final touches 
legend.beta = legend.beta +
  theme(plot.margin = margin(t = 0, r = -1, b = 0, l = -5, unit = "mm"))

#check size
#legend.beta + canvas(height = 10, width = 20, units = "mm", dpi = 300)

## DA Plot Legend ----

### Set Up ----

df.prim = data.frame(
  x = rep(1, times = 3),
  y = factor(c(1:3), levels = 1:3, ordered=T),
  fill.col = factor(c("q < 0.05", "q < 0.1","q \u2265 0.1"), ordered = T, levels = c("q < 0.05", "q < 0.1","q \u2265 0.1")))
df.dummy = data.frame(x = 1, y = 1)
df.bp = data.frame(x = rnorm(n = 100, mean = 0, sd = 1),
                   group = factor(c(rep(2, times = 50), rep(3, times = 50)), levels = c(2:3)),
                   fill.col = factor(c(rep("Primary", times = 50), rep("Metastatic", times = 50)), levels = c("Primary", "Metastatic")))

### Dummy Plot ----
dummy.legend.da = ggplot() + 
  geom_point(data = df.prim, aes(x=x, y = y, color = fill.col), size = 1) +
  geom_point(data = df.dummy, aes(x=x, y = y, size = "met1"), color = "gray75") +
  geom_point(data = df.dummy, aes(x=x, y = y, size = "met2"), color = "#eea8ba") +
  geom_point(data = df.dummy, aes(x=x, y = y, size = "met3"), color = "#d83e65") +
  theme_bw() +
  scale_color_manual("> Primary Prevalence", 
                     values = c("#98ab76","#ced1af", "gray75"),  # c("#45812f", "#8AB833", "gray75")
                     guide=guide_legend(order=1)) +
  scale_size_manual(
    "> Metastatic Prevalence", 
    values=rep(1,3),
    #guide=guide_legend(order = 2, override.aes = list(colour=c("#d83e65", "#eea8ba", "gray75"))),
    guide=guide_legend(order = 2, override.aes = list(colour=c("#c62320", "#f05b43", "gray75"))),  # red metastatic
    labels=c("q < 0.05", "q < 0.1","q \u2265 0.1"))

dummy.legend.da  # display


### Format ----

dummy.format.legend.da = dummy.legend.da + 
  theme(legend.title = element_text(size = 10, face = "bold", margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm")),
        legend.text = element_text(size = 8, margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm")),
        legend.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm"),
        legend.box.spacing = unit(0, "mm"),
        legend.box.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm"),
        legend.key.height = unit(3, "mm"),
        legend.key.width = unit(4, "mm"))
dummy.format.legend.da

### Extract Legend ----

#grab legend
legend.da = dummy.format.legend.da %>% 
  get_legend()
legend.da = legend.da %>% 
  as_ggplot()

#final touches 
legend.da = legend.da +
  theme(plot.margin = margin(t = 0, r = -1, b = 0, l = -5, unit = "mm"))

#check size
#legend.da + canvas(height = 40, width = 20, units = "mm", dpi = 300)

# Print to PNG ----

## External 2A Legend (2col) ----

### Layout Matrix ----

#nrow (height) should be 206, ncol (width) should be 138
layout.mat = matrix(data = NA, nrow = 206, ncol = 138)
layout.mat[1:38,1:46] = 1 #beta 1
layout.mat[1:38,47:82] = 2 #beta 2
layout.mat[1:38,83:118] = 3 #beta 3
layout.mat[1:14,119:138] = 4 #upper beta legend spacer
layout.mat[15:24,119:138] = 5 #beta legend
layout.mat[25:38,119:138] = 6 #lower beta legend spacer
layout.mat[39:94,1:59] = 7 #b
layout.mat[39:94,60:118] = 8 #c
layout.mat[95:150,1:59] = 9 #d
layout.mat[95:150,60:118] = 10 #e
layout.mat[151:206,1:29] = 11 #spacer
layout.mat[151:206,30:88] = 12 #f
layout.mat[151:206,89:118] = 13 #spacer
layout.mat[39:73,119:138] = 14 #dalegend upper spacer
#layout.mat[74:113,119:138] = 15 #dalegend
layout.mat[147:193,110:129] = 15
layout.mat[114:206,119:138] = 16 #dalegend lower spacer
#(everything is set at 36w x 38, with first panel set to 40w x 38)
#desired with of 46w x 38 

#check layout
gs <- lapply(1:16, function(ii) 
  grobTree(rectGrob(gp=gpar(fill=ii, alpha=0.5)), textGrob(ii)))
grid.arrange(grobs = gs, layout_matrix = layout.mat)


### Plot List ----

#spacer set up
plt.spacer = ggplot() + theme_void()

#list plots including spacers and conver to grobs
list.grob = list(ord.format[[1]], 
                 ord.format[[2]],
                 ord.format[[3]], 
                 plt.spacer, 
                 legend.beta,
                 plt.spacer,
                 withlabs[[1]], 
                 withlabs[[2]],
                 withlabs[[3]], 
                 withlabs[[4]], 
                 plt.spacer,
                 withlabs[[5]],
                 plt.spacer,
                 plt.spacer,
                 legend.da,
                 plt.spacer)
list.grob = lapply(list.grob, ggplotGrob)

### Print ----
png("../figures/Figure2.png", 
    width = 138, 
    height = 206, 
    res = 300, 
    units = "mm")
grid.arrange(grobs = list.grob, layout_matrix = layout.mat)
dev.off()

