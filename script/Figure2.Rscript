# Fig 2A (Beta Diversity) ----

## Set Up ----

#grab results
obj.w = output$Stage_age_BetaDiversity_Species

#ordination set up
dist.list = obj.w$input$Measures #get similarities metrics for ordination
dist.name.vec = c("Bray Curtis", "Unifrac", "Weighted Unifrac")

## Initial Ordination (Long) ----
ord.list = lapply(1:length(dist.list), function(i){
  #set seed
  set.seed(seed.val)
  #grab distance, distance names, and phyloseq input
  dist.tmp = dist.list[[i]]
  dist.nm = dist.name.vec[i]
  phylo.tmp = obj.w$input$Phyloseq
  #change sample data for better graphing
  md.tmp = sample_data(phylo.tmp) %>% data.frame()
  md.tmp = md.tmp %>% mutate(prim_or_met = prim_or_met_factor)
  sample_data(phylo.tmp) = sample_data(md.tmp)
  
  #get title
  title.tmp = dist.nm %>% str_to_title()
  title.tmp = paste0("\u273B", " ", title.tmp)
  #ordinate
  ord.tmp = ordinate(physeq = phylo.tmp, method = "PCoA", distance = paste0(dist.tmp))
  ord.plt.tmp = plot_ordination(physeq=phylo.tmp, 
                                ordination = ord.tmp, 
                                type="samples", 
                                color = "prim_or_met") +
    labs(title=title.tmp) +
    theme_classic() +
    theme(legend.position = "none")
  return(ord.plt.tmp)
})
names(ord.list) = names(dist.list)



## Format Ordinations ----
ord.format = ord.list
ord.format = lapply(ord.format, function(plt.tmp){
  #fix point size
  plt.tmp$layers[[1]]$geom$default_aes$size = a.pt.sz
  plt.tmp$layers[[1]]$geom$default_aes$stroke = 0
  
  #fix axis titles
  axistitle.new = plt.tmp$plot_env$strivar %>%
    gsub(pattern = "\\[", replacement = "(") %>%
    gsub(pattern = "\\]", replacement = ")") %>%
    gsub(pattern = "   ", replacement = " ")
  xlab.new = axistitle.new[1]
  ylab.new = axistitle.new[2]
  
  #remaining formatting
  plt.tmp = plt.tmp +
    scale_color_manual(values = a.pal) +
    xlab(xlab.new) + ylab(ylab.new) +
    theme(axis.title = element_text(size = a.axis.title.sz),
          axis.text = element_text(size = a.axis.text.sz),
          axis.text.x = element_text(margin = margin(t = 0.25, unit = "mm")),
          axis.text.y = element_text(margin = margin(r=0, unit = "mm")),
          legend.text = element_text(size = a.legend.text.sz),legend.title = element_text(size = a.legend.title.sz), #added
          plot.title = element_text(hjust = a.plt.title.hjust, 
                                    vjust = a.plt.title.vjust, 
                                    size = a.plt.title.sz, 
                                    margin = margin(t=0, b = 2, unit = "mm")),
          aspect.ratio = 1, 
          axis.line = element_line(linewidth = unit(0.25, units = "mm")),
          axis.ticks = element_line(linewidth = unit(0.25, units = "mm")),
          axis.ticks.length = unit(0.5, units = "mm"),
          axis.title.y = element_text(vjust = -1.5),
          axis.title.x = element_text(vjust = 3),
          plot.margin = margin(l = 0, b = 0, r = 0, t = 0, unit = "mm"))
  return(plt.tmp)
})

## Add Panel Letter ----

ord.format[[1]] = ord.format[[1]] +
  labs(tag = "A") +
  theme(plot.margin = margin(l = 9, b = 0, r = 0, t = 0, unit = "mm"),
        plot.tag = element_text(size = 10, hjust = 1, vjust = 1),
        plot.tag.location = "plot",
        plot.tag.position = c(-0.2,0.95))






# Fig 2B (Genus) ----

## Main ----

### Set Up ----

#grab results
obj.w = output$Stage_age_Taxonomic_Genus

#prep table
prep = da_plt_prep(obj = obj.w, type = "auto", cuts = c(0.05, 0.1),
                   label.crit = c("x < 0.1"), ntop = 10)
#grab mean abundances and add to prep table
#abund_w = get_abund(feature.dat = obj.w$output$test.object$feature.dat, type = "count")
abund_w = norm.fxn(object = obj.w) %>% colMeans()
#abund_w = data.frame(nm = names(abund_w), abundance = abund_w)
abund_w = data.frame(nm = gsub(pattern = "\\.", replacement = "-", x = names(abund_w)), abundance = abund_w)
prep$df = left_join(prep$df, abund_w, by = c("Feature_W" = "nm"))


#prep palette
levels(prep$df$signif_level)
prep$df$signif_level %>% unique()
pal.w = da.pal.master[prep$df$signif_level %>% unique()]

### Plotting ----
plt.w = da_plt(obj.prep = prep, type = "auto",
               pt.color = pal.w,
               pt.size = da.pt.size,
               legend.tf = da.legend.tf,
               xlab.size = da.xlab.sz,
               ylab.size = da.ylab.sz, text.size=plt.axis.sz,
               tick.size = da.tick.sz,
               label.size.param = da.label.size.param,
               box.pad.size = da.box.pad.size, 
               point.pad.size = da.point.pad.size,
               max.overlaps.param = da.max.overlaps.param,
               max.iter.param = da.max.iter.param,
               max.time.param = da.max.time.param,
               force.param = da.force.param,
               force.pull.param = da.force.pull.param,
               skiplabel = F, 
               pt.lim = da.pt.lim, 
               pt.rng = da.pt.rng, 
               pt.brks = da.pt.brks)
fig.2b = plt.w 

