# Modifying DA Plots ----

## Main Plot Theme Adj ----
plt.da.list = list(fig.2b, fig.2c, fig.2d, fig.2e, fig.2f)
plt.da.list = lapply(plt.da.list, function(plt.tmp){
  plt.tmp = plt.tmp +
    theme(aspect.ratio = 1, 
          axis.line = element_line(linewidth = unit(0.25, units = "mm")),
          axis.ticks = element_line(linewidth = unit(0.25, units = "mm")),
          axis.ticks.length = unit(0.5, units = "mm"),
          axis.title.y = element_text(vjust = 1.5), #-1.5
          axis.title.x = element_text(vjust = 1.25), # 3
          plot.margin = margin(l = 0, b = 0, r = 0, t = 0, unit = "mm"))
  op = plt.tmp
  return(op)
})

#change "Coefficient to R2"
plt.da.list = lapply(plt.da.list, function(plt.tmp){
  plt.tmp = plt.tmp + xlab(label = bquote(R^2))
  op = plt.tmp
  return(op)
})

