## KM Plotting ----



    xlabs = "Time (Months)"
    ylabs = "P(Surv)"
    xbr = c(0, 24, 48)
    ybr = c(0, 0.5, 1)
    xlims = c(0, max(xbr))
    ylims = c(0,1)


### Raw Plot & Initial Formatting----
km.raw = lapply(list.w, function(obj.tmp){
  #grab results df and metadata
  res.df = obj.tmp$df %>% filter(padj < 0.1)
  md.tmp = obj.tmp$obj$input$Phyloseq %>% sample_data() %>% data.frame()
  #specify time and event columns
  timecol = obj.tmp$obj$input$timecol
  eventcol = obj.tmp$obj$input$eventcol
  #grab features of interest
  foi = obj.tmp$df %>% filter(padj < 0.1) %>% select(Feature_W) %>% unlist() %>% as.vector()
  
  #put features and metadata together
  #subset down to features of interest, sampleid, and pfs columns
  toget = c("SAMPLEID", timecol, eventcol, foi)
  df.plt = obj.tmp$df.norm
  df.plt = right_join(md.tmp, df.plt, by = "SAMPLEID") %>%
    select(all_of(toget))
  df.plt = df.plt %>% mutate(across(all_of(foi), .fns = ~factor(ifelse(.x >= median(.x), yes = "\u2265 Median", no = "< Median"), levels = c("< Median", "\u2265 Median"))))
  
  fit.list = lapply(foi, function(feat.tmp){
    #formula and fit curve
    form.tmp = paste0('Surv(time = ', timecol, ", event = ", eventcol, ") ~ ", feat.tmp) %>% as.formula()
    set.seed(seed.val)
    fit.tmp = survfit(formula = form.tmp, data = df.plt)
    
    #plot set up
    times <- fit.tmp$time
    title.tmp = res.df[res.df$Feature_W == feat.tmp,"Feature_Clean"] %>% unlist() %>% as.vector()
    
    #add signif if necessary
    char.add = ""
    if((res.df[res.df$Feature_W == feat.tmp,"padj"] %>% unlist() %>% as.vector()) < 0.05){
      char.add = ' \u2020' #" \u2051" # " \u2193"
    }
    if((res.df[res.df$Feature_W == feat.tmp,"padj"] %>% unlist() %>% as.vector()) < 0.1 & (res.df[res.df$Feature_W == feat.tmp,"padj"] %>% unlist() %>% as.vector()) >= 0.05){
      char.add = " \u2a"
    }
    title.tmp = paste0(title.tmp, char.add)
    
    #df.plot initialization
    subs1 <- 1:length(levels(summary(fit.tmp)$strata))
    subs2 <- 1:length(summary(fit.tmp,censored=T)$strata)
    subs3 <- 1:length(summary(fit.tmp,times = times,extend = TRUE)$strata)
    
    #format groups
    raw.group = summary(fit.tmp, censored = T)$strata[subs2] %>% as.character()
    equal.ind = gregexpr(pattern = "=", text = raw.group) %>% unlist()
    format.group = str_sub(raw.group, start = equal.ind+1, end = nchar(raw.group))
    lvl.strata = format.group %>% unique()
    lvl.all = c(lvl.strata, paste0(lvl.strata, "XYZ"))
    Factor = factor(format.group, levels = lvl.all)
    
    .df = data.frame(
      time = fit.tmp$time[subs2],
      n.risk = fit.tmp$n.risk[subs2],
      n.event = fit.tmp$n.event[subs2],
      n.censor = fit.tmp$n.censor[subs2],
      surv = fit.tmp$surv[subs2],
      strata = Factor,
      upper = fit.tmp$upper[subs2],
      lower = fit.tmp$lower[subs2]
    )
    zeros = data.frame(
      time = 0,
      n.risk = NA,
      n.event = NA,
      n.censor = NA,
      surv = 1,
      strata = factor(levels(Factor)[1:2], levels = levels(Factor)),
      upper = 1,
      lower = 1
    )
    .df = rbind.data.frame(zeros, .df)
    .df$col.pt = factor(paste0(.df$strata %>% as.character(), "XYZ"), levels = levels(.df$strata))
    #.df$title.col = paste0(" \n", title.tmp , "\n ")
    .df$title.col = title.tmp
    
    .df$col.pt = as.numeric(.df$col.pt)-2
    .df$col.pt = c("#308692","#5d7c22")[.df$col.pt]
    op = .df
  })
  df.master = do.call(rbind.data.frame, fit.list)
  df.master$title.col = factor(df.master$title.col, levels = unique(df.master$title.col), ordered = T)
  
  #set number of rows
  param.nrow = 1
  if(length(fit.list) < 3){
    param.nrow = 1
    param.ncol = ceiling(length(fit.list)/param.nrow)
    if(length(fit.list) == 1){
      des.tmp = "A"
    } else{
      des.tmp = "AB"
    }
  param.panel.width = 32
  param.panel.height = 20

  }
  if(length(fit.list) > 2 & length(fit.list) < 7){
    param.nrow = 1
    param.ncol = 6
    des.tmp = "ABCDEF"
  param.panel.width = 24
  param.panel.height = 17.25

  }
  if(length(fit.list) > 6){
    param.nrow = 3
    param.ncol = 4
    des.tmp = "
    ABCD
    EFGH
    IJK#"
  param.panel.width = 32
  param.panel.height = 20

  }
  #set number of cols
  #param.ncol = ceiling(length(fit.list)/param.nrow)

  
  plt.init = ggplot(df.master, aes(time, surv)) +
    geom_step(aes(color = strata), linewidth = 0.4) +
    geom_point(data = subset(df.master, n.censor >= 1), aes(x = time, y = surv),  shape = 2, size = 3, stroke = 0.6, color = subset(df.master, n.censor >= 1)$col.pt) +
    scale_x_continuous(xlabs, breaks = xbr, limits = xlims) +
    scale_y_continuous(ylabs, breaks = ybr, limits = ylims) +
    facet_manual(.~title.col, design = des.tmp) +
    force_panelsizes(rows = unit(x = rep(param.panel.height, times = param.nrow), units = "mm"),
                     cols = unit(x = rep(param.panel.width, times = param.ncol), units = "mm")) +
    theme_pubr(border = T)
  
  
  #linewidth and size of censor mark
  plt.init$layers[[1]]$aes_params$linewidth = 0.5
  plt.init$layers[[2]]$aes_params$size = 0.55
  
  plt.master = plt.init +
    scale_color_manual(values = c(rdn[3], rdn[12])) +
    theme(legend.position = "none",
          plot.title = element_text(size = 10, hjust = 0.5, face="bold", color = "black", margin = margin(b = 0.5, unit = "mm")),
          strip.text.x = element_text(size = 8, margin = margin(t = 0.25, b = 0.25, r = 0, l = 0, unit = "mm")),
          strip.background.x = element_rect(linewidth = 0.25),
          panel.border = element_rect(linewidth = 0.25),
          panel.spacing.x = unit(0.5, units = "mm"),
          panel.spacing.y = unit(0.5, units = "mm"),
          axis.title.x = element_text(size = 9, color = "black", margin = margin(t=0, unit = "mm")),
          axis.title.y = element_text(size = 9, color = "black", margin = margin(r = 0, unit = "mm")),
          axis.text.x = element_text(size = 7, color = "black", margin = margin(t = 0.1, unit = "mm")),
          axis.text.y = element_text(size = 7, color = "black", margin = margin(r = 0.1, unit = "mm")),
          axis.line = element_line(linewidth = unit(0, units = "mm")),
          axis.ticks = element_line(linewidth = unit(0.25, units = "mm")),
          axis.ticks.length = unit(0.5, units = "mm"),
          plot.margin = margin(t=1., r=0.75, b=0.5, l = 0.75, unit = "mm"),
          plot.background = element_rect(fill = "white"))
  
  return(plt.master)
})


