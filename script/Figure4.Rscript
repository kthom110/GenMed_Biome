## Define Functions ----
#for DA prep function
source("DA_plot_wrapper.R")

norm.fxn = function(features, object){
  obj.tmp = object
  type.tmp = obj.tmp$input$FeatureType
  if(type.tmp == "Taxonomic"){
    print("doing Taxonomic...")
    #get unpruned feature df
    df.tmp = obj.tmp$input$Phyloseq %>% otu_table() %>% data.frame() %>% t()
    rownames(df.tmp) = gsub(pattern = "\\.", replacement = "-", x = rownames(df.tmp))
    
    #grab depth before anything else
    depth.tmp = colSums(df.tmp)
    #winsorize (counts)
    df.tmp = apply(df.tmp, MARGIN = 1, function(x){
      qt = quantile(x, 1-0.03)
      x[x >= qt] <- qt
      return(x)
    }) %>% t()
    
    #TSS (based on unpruned feature matrix)
    df.tmp = t(df.tmp)/depth.tmp
    df.tmp = df.tmp %>% data.frame()
    
  } else if (type.tmp =="Functional"){
    print("doing Functional...")
    df.tmp = obj.tmp$output$test.object$feature.dat
    
    #TSS (based on pruned feature matrix)
    df.tmp = t(df.tmp)/colSums(df.tmp)
    df.tmp = df.tmp %>% data.frame()
    
    #winsorize
    df.tmp = apply(t(df.tmp), MARGIN = 1, function(x){
      qt = quantile(x, 1-0.03)
      x[x >= qt] <- qt
      return(x)
    }) %>% data.frame()
  }
  #square root
  df.tmp = df.tmp^0.5
  
  #select features of interest
  df.tmp = df.tmp %>% rownames_to_column(var = "SAMPLEID") %>% select(all_of(c("SAMPLEID", features)))
  op = df.tmp
  return(op)
  
}


# (Fig A) Time Plots ----
list.w = time.output[c("PROMISE_Time_Taxonomic_Genus")]
list.w = lapply(list.w, function(obj.tmp){
  op = da_plt_prep(obj = obj.tmp, type = "auto", cuts = c(0.05, 0.1),
                   label.crit = c("x < 0.1"), ntop = 10)
})

list.w = lapply(list.w, function(obj.tmp){
  #get features to plt
  foi = obj.tmp$df %>% filter(padj < 0.1) %>% select(Feature_W) %>% unlist() %>% as.vector()
  norm.tmp = norm.fxn(features = foi, object = obj.tmp$obj)
  op = c(obj.tmp, "df.norm" = list(norm.tmp))
  return(op)
})


df.4a = lapply(list.w, function(obj.tmp){
  #grab results df and metadata
  res.df = obj.tmp$df %>% filter(padj < 0.1)
  md.tmp = obj.tmp$obj$input$Phyloseq %>% sample_data() %>% data.frame()
  #grab features of interest
  foi = obj.tmp$df %>% filter(padj < 0.1) %>% select(Feature_W) %>% unlist() %>% as.vector()
  
  #put features and metadata together
  #subset down to features of interest, sampleid, and pfs columns
  toget = c("SAMPLEID", "SAMPLEVISITTPDESC_factor", "ANALYSISID", foi)
  df.plt = obj.tmp$df.norm
  df.plt = right_join(md.tmp, df.plt, by = "SAMPLEID") %>%
    select(all_of(toget))
  df.plt$SAMPLEVISITTPDESC_factor = as.character(df.plt$SAMPLEVISITTPDESC_factor)
  df.plt$SAMPLEVISITTPDESC_factor = factor(ifelse(df.plt$SAMPLEVISITTPDESC_factor == "pre_reg", yes = "Pre-Treatment", no = "Cycle2"), levels = c("Pre-Treatment", "Cycle2"), ordered = T)
  return(df.plt)
})
