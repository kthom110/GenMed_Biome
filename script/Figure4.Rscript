km.format = lapply(1:length(km.postmargin), function(i){
  plt.tmp = km.postmargin[[i]]
  lab.tmp = lab.vec[i]
  plt.tmp = plt.tmp +
    labs(tag = lab.tmp) +
    theme(plot.tag = element_text(size = 10, hjust = 0.5, vjust = 0.5, margin=margin(0,0,0,0, unit = "mm")),
          plot.tag.location = "plot",
          plot.tag.position = c(0,1))
  return(plt.tmp)
})

