## Inset ----

### Set Up & Normalization ----

#get ZicoSeq normalized data
obj.w = output$NAC_Response_age_subtypeadj_Functional_Pathway

#feature of interest
foi = "X354"   # feature names were not kept

df.w = obj.w$output$test.object$feature.dat
md.w = obj.w$output$test.object$meta.dat

#TSS (based on pruned feature matrix)
df.w = t(df.w)/colSums(df.w)
df.w = df.w %>% data.frame()

#winsorize
df.w = apply(t(df.w), MARGIN = 1, function(x){
  qt = quantile(x, 1-0.03)
  x[x >= qt] <- qt
  return(x)
}) %>% data.frame()

#sqrt
df.w = df.w^0.5

#format
df.w = left_join(md.w, df.w %>% rownames_to_column(var = "SAMPLEID") %>% select(all_of(c("SAMPLEID", foi))), by = "SAMPLEID")
df.w = df.w %>% mutate('RCB Score' = factor(rcb_score_factor))

### Plotting ----

plt.inset.fig3f= ggplot(data = df.w, aes(x=`RCB Score`, fill = `RCB Score`, y = .data[[foi]])) +
  geom_boxplot(linewidth = unit(0.25, units = "mm"), outlier.size = 0.15) + theme_classic() + 
  ylab("Sqrt Abundance") +
  ggtitle("PWY-7328") +
  scale_fill_manual(values = c("#FCE4F9","#E8C7F9", "#BEB1FF", "#6551CC")) +
  scale_y_continuous(breaks = c(0.04, 0.06)) +
  theme(legend.position = "none",
        aspect.ratio = NULL,
        axis.title.x = element_blank(),
        axis.title.y = element_text(size = 4.5, margin = margin(r = 0.25, unit = "mm")),
        axis.text = element_text(size = 5),
        axis.text.y = element_text(angle = 0, margin = margin(l = 0.25, r = 0, unit = "mm"), hjust = 0.5, color = "black"),
        axis.text.x = element_blank(),
        axis.line = element_line(linewidth = unit(0.25, units = "mm")),
        axis.ticks.y = element_line(linewidth = unit(0.25, units = "mm")),
        axis.ticks.x = element_blank(),
        axis.ticks.length.y = unit(0.5, units = "mm"),
        plot.margin = margin(l = 0.5, b = 0.5, r = 0.5, t = 0.5, unit = "mm"),
        plot.background = element_rect(color = "black", linewidth = unit(0.25, units = "mm")),
        plot.title = element_text(size = 5, hjust = 0.5, margin = margin(unit = "mm")))
plt.inset.fig3f


# Modifying DA Plots ----

# Holder -> fig.3e = ggplot() + theme_void() 
obj.w = output$NAC_Response_age_subtypeadj_Taxonomic_Species


#prep table
prep = da_plt_prep(obj = obj.w, type = "auto", cuts = c(0.05, 0.15),
                   label.crit = c("x < 0.15"), ntop = 10)
#grab mean abundances and add to prep table
#abund_w = get_abund(feature.dat = obj.w$output$test.object$feature.dat, type = "count")

abund_w = norm.fxn(object = obj.w) %>% colMeans()

#abund_w = data.frame(nm = names(abund_w), abundance = abund_w)

abund_w = data.frame(nm = gsub(pattern = "\\.", replacement = "-", x = names(abund_w)), abundance = abund_w)
prep$df = left_join(prep$df, abund_w, by = c("Feature_W" = "nm"))

#prep palette
levels(prep$df$signif_level)
prep$df$signif_level %>% unique()

pal.w = da.pal.master[prep$df$signif_level %>% unique()]

## Plotting ----

plt.w = da_plt(obj.prep = prep, type = "auto",
               pt.color = pal.w,
               pt.size = da.pt.size,
               legend.tf = da.legend.tf,
               xlab.size = da.xlab.sz,
               ylab.size = da.ylab.sz, text.size=plt.axis.sz,
               tick.size = da.tick.sz,
               label.size.param = da.label.size.param,
               box.pad.size = da.box.pad.size, 
               point.pad.size = da.point.pad.size,
               max.overlaps.param = da.max.overlaps.param,
               max.iter.param = da.max.iter.param,
               max.time.param = da.max.time.param,
               force.param = da.force.param,
               force.pull.param = da.force.pull.param)

fig.3e = plt.w 






## Main Plot Theme Adj ----
plt.da.list = list(fig.3d, fig.3e, fig.3f)
plt.da.list[2:3] = lapply(plt.da.list[2:3], function(plt.tmp){
  plt.tmp = plt.tmp +
    theme(aspect.ratio = 1, 
          axis.line = element_line(linewidth = unit(0.25, units = "mm")),
          axis.ticks = element_line(linewidth = unit(0.25, units = "mm")),
          axis.ticks.length = unit(0.5, units = "mm"),
          axis.title.y = element_text(vjust = 1.5),
          axis.title.x = element_text(vjust = 1.25),
          plot.margin = margin(l = 0, b = 0, r = 0, t = 0, unit = "mm"))
  op = plt.tmp
  return(op)
})

#check sizing
plt.da.list[[1]] + canvas(width = 56, height = 56, units = "mm", dpi = 300)
plt.da.list[[2]] + canvas(width = 56, height = 56, units = "mm", dpi = 300)
plt.da.list[[3]] + canvas(width = 56, height = 56, units = "mm", dpi = 300)


## Add Insets ----

### Inset Fig 3F ----

#get dimensions of inset
dim.inset.fig3f = get_window(x = 0.5,
                             y = 0.33,
                             bl.x = 0.1,
                             bl.y = 0.63,
                             plt = plt.da.list[[3]])


#convert inset to grob
grob.plt.inset.fig3f = ggplotGrob(plt.inset.fig3f)

#set zoom dimensions
zoomdata.fig3f <- data.frame(x = c(-0.0081160880+0.0001, dim.inset.fig3f$xmin, dim.inset.fig3f$xmax, -0.0081160880+0.0001),
                             y = c(-log10(0.00041), dim.inset.fig3f$ymax, dim.inset.fig3f$ymax, -log10(0.00041)))

#plot 
fig3f.winset = plt.da.list[[3]] +
  with_shadow(geom_rect(aes(xmin = dim.inset.fig3f$xmin,
                            xmax = dim.inset.fig3f$xmax,
                            ymin = dim.inset.fig3f$ymin,
                            ymax = dim.inset.fig3f$ymax),
                        fill = "red",
                        linewidth = unit(0, "mm")),
              sigma = 3,
              x_offset = 3,
              y_offset = 3)  +
  geom_polygon(data = zoomdata.fig3f, aes(x, y),
               fill = "gray90", alpha = 1, color = "black", linewidth = unit(0, "mm")) +
  annotation_custom(grob = grob.plt.inset.fig3f,
                    xmin = dim.inset.fig3f$xmin, xmax = dim.inset.fig3f$xmax,
                    ymin = dim.inset.fig3f$ymin, ymax = dim.inset.fig3f$ymax)




#check size
#fig3f.winset + canvas(width = 56, height = 56, units = "mm", dpi = 300)

## Add Panel Labels ----

#grab letters for panels
panel.labs = LETTERS[4:6]

#grab plots we want to add letters to
toaddlabs = list(plt.da.list[[1]], plt.da.list[[2]], fig3f.winset )

#add letters and adjust margins where needed
withlabs = lapply(1:length(toaddlabs), function(i){
  plt.tmp = toaddlabs[[i]]
  lab.tmp = panel.labs[i]
  plt.tmp = plt.tmp +
    labs(tag = lab.tmp) +
    theme(plot.margin = margin(l = 3, b = 0, r = 0, t = 0, unit = "mm"),
          plot.tag = element_text(size = 10, hjust = 1, vjust = 1),
          plot.tag.location = "plot", 
          plot.tag.position = c(0,1))
  return(plt.tmp)
})



# Legends ----

## Fig 3C Legend ----

### Set Up ----
df.asterisk = data.frame(
  x = rep(1, times = 1),
  y = factor(c(1), levels = 1, ordered=T),
  fill.col = factor(c("p < 0.05"), ordered = T, levels = c("p < 0.05")))

### Dummy Plot ----
dummy.legend.alpha = ggplot() + 
  geom_point(data = df.asterisk, aes(x = x, y = y, color = fill.col), size = 2, shape = "\u273B") +
  scale_color_manual(values = c("black")) +
  theme_bw()

### Format ----
dummy.format.legend.alpha = dummy.legend.alpha+ 
  theme(legend.title = element_blank(),
        legend.text = element_text(size = 6, margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm")),
        legend.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm"),
        legend.box.spacing = unit(0, "mm"),
        legend.box.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm"),
        legend.key.height = unit(3, "mm"),
        legend.key.width = unit(4, "mm")) 
dummy.format.legend.alpha

### Extract Legend ----

#grab legend
legend.alpha = dummy.format.legend.alpha %>% 
  get_legend()
legend.alpha = legend.alpha %>% 
  as_ggplot()

#final touches 
legend.alpha = legend.alpha +
  theme(plot.margin = margin(t = -4, r = legend.alpha.rmargin, b = 0, l = 0, unit = "mm"))

## DA Plot Legend ----

### Set Up ----

df.better = data.frame(
  x = rep(1, times = 2),
  y = factor(c(1:2), levels = 1:3, ordered=T),
  fill.col = factor(c("q < 0.15","q \u2265 0.15"), ordered = T, levels = c("q < 0.05", "q < 0.15","q \u2265 0.15")))
df.dummy = data.frame(x = 1, y = 1)
df.bp = data.frame(x = rnorm(n = 100, mean = 0, sd = 1),
                   group = factor(c(rep(1, times = 25), rep(2, times = 25), rep(3, times = 25), rep(4, times = 25)), levels = c(1:4)),
                   fill.col = factor(c(rep("RCB-0", times = 25), rep("RCB-1", times = 25), rep("RCB-2", times = 25), rep("RCB-3", times = 25)), levels = c("RCB-0", "RCB-1", "RCB-2", "RCB-3")))

### Dummy Plot ----
dummy.legend.da = ggplot() + 
  geom_point(data = df.better, aes(x=x, y = y, color = fill.col), size = 1) +
  geom_point(data = df.dummy, aes(x=x, y = y, size = "high1"), color = "gray75") +
  geom_point(data = df.dummy, aes(x=x, y = y, size = "high2"), color = "#eea8ba") +
  geom_boxplot(data = df.bp, aes(x = x, fill = fill.col)) +
  theme_bw() +
  scale_color_manual("\u2193 With Burden", 
                     values = c("#98ab76", "gray75"), #8AB833 green
                     guide=guide_legend(order=1)) +
  scale_size_manual(
    "\u2191 With Burden", 
    values=rep(1,3),
    guide=guide_legend(order = 2, override.aes = list(colour=c("#c62320", "gray75"))), #eea8ba red
    labels=c("q < 0.15","q \u2265 0.15")) +
  scale_fill_manual("Inset", values = c("#FCE4F9","#E8C7F9", "#BEB1FF", "#6551CC"))
dummy.legend.da 

### Format ----

dummy.format.legend.da = dummy.legend.da + 
  theme(legend.title = element_text(size = 7, face = "bold", margin = margin(t = 0, r = 4, b = 0, l = 0, unit = "mm")),
        legend.text = element_text(size = 6, margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm")),
        legend.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm"),
        legend.box.spacing = unit(0, "mm"),
        legend.box.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm"),
        legend.key.height = unit(3, "mm"),
        legend.key.width = unit(4, "mm"),
        legend.direction = "horizontal", 
        legend.position = "bottom",
        legend.spacing = unit(10, "mm")) 
dummy.format.legend.da

### Extract Legend ----

#grab legend
legend.da = dummy.format.legend.da %>% 
  get_legend()
legend.da = legend.da %>% 
  as_ggplot()

#final touches 
# legend.da = legend.da +
#   theme(plot.margin = margin(t = 0, r = -1, b = 0, l = -5, unit = "mm"))
legend.da = legend.da +
  theme(plot.margin = margin(t = 0, r = 0, b = 0, l = 0, unit = "mm"))

#check size
legend.da + canvas(height = 5, width = 170, units = "mm", dpi = 300)

