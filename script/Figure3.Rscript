# Fig 3C (Alpha Diversity) -----



## Set Up ----


#grab results
obj.w = output$NAC_Response_age_subtypeadj_AlphaDiversity_Species
#set up different metrics
alpha.list = c("Observed", "Shannon")

df.w = obj.w$output$data %>% mutate(rcb_score = factor(rcb_score, levels = c(0, 1, 2, 3))) %>% mutate(RCB = rcb_score)

## Plotting ----
alpha.plt.list = lapply(alpha.list, function(var.tmp){
  if(var.tmp == "Observed"){
    newlab = "Observed Species"
  }
  if(var.tmp == "Shannon"){
    newlab = "Shannon Index"
  }
  plt.tmp = ggplot(data = df.w, aes(x=RCB, fill = rcb_score, y = .data[[var.tmp]])) + 
    geom_boxplot(lwd = param.3c.boxplot.lwd) +
    ylab(label = newlab) +
    scale_fill_manual(values = param.3c.boxplot.fill) +
    theme_classic() +
    theme(legend.position = "none", 
          axis.title.x = element_text(size = param.3c.axis.title.size, margin = margin(l = 0, b = 0, r = 0, t = 0, unit = "mm")), 
          axis.title.y = element_text(size = param.3c.axis.title.size, margin = margin(l = 0, b = 0, r = 0, t = 0, unit = "mm")),
          aspect.ratio = 1, 
          axis.line = element_line(linewidth = param.3c.axis.lwd),
          axis.ticks = element_line(linewidth = param.3c.axis.ticks.lwd),
          axis.ticks.length = param.3c.axis.ticks.length,
          axis.text.x = element_text(size = param.3c.axis.text.size, margin = margin(t = 0.1, unit = "mm")),
          axis.text.y = element_text(size = param.3c.axis.text.size, margin = margin(r=0, unit = "mm"), hjust = 1),
          plot.margin = margin(l = 5, b = 5, r = 0, t = 0, unit = "mm"))
  
  #add asterisk
  ast = grobTree(textGrob("\u273B", x=0.2,  y=0.2, hjust=0,
                          gp=gpar(col="black", fontsize=10)))
  plt.tmp = plt.tmp + annotation_custom(ast)
  return(plt.tmp)
})



## Fix y-axis text spacing ----
statement.glue = "<span style='color:white'>{whitetext}</span><span style='color:black'>{blacktext}</span>"


#plot 1 setup
labs.p1 = tibble(
  "breaks.vec" = seq(900, 1800, 200),
  "blacktext" = as.character(signif(breaks.vec, digits = 2)),
  "whitetext" = "\\."
)
labs.p1[labs.p1$breaks.vec == 900,"whitetext"] = "\\."
labs.p1 = labs.p1 %>% mutate(
  name = glue(statement.glue)
)

#plot 2 setup
labs.p2 = tibble(
  "breaks.vec" = seq(2.5, 5, 0.5),
  "blacktext" = format(signif(breaks.vec, digits = 2), nsmall = 1),
  "whitetext" = "00"
)
labs.p2 = labs.p2 %>% mutate(
  name = glue(statement.glue)
)

#plot
alpha.plt.list[[1]] = alpha.plt.list[[1]] + 
  scale_y_continuous(breaks = labs.p1$breaks.vec, labels = labs.p1$name) +
  theme(axis.text.y = element_markdown(debug=F))
alpha.plt.list[[2]] = alpha.plt.list[[2]] + 
  scale_y_continuous(breaks = labs.p2$breaks.vec, labels = labs.p2$name) +
  theme(axis.text.y = element_markdown(debug = F))
## Add Panel Letter ----

alpha.plt.list[[1]] = alpha.plt.list[[1]] +
  labs(tag = "C") +
  theme(plot.margin = margin(l = 3, b = 0, r = 0.5, t = 0, unit = "mm"),
        plot.tag = element_text(size = 10, hjust = 1, vjust = 1),
        plot.tag.location = "plot",
        plot.tag.position = c(-0.025,1))
alpha.plt.list[[2]] = alpha.plt.list[[2]] +
  labs(tag = "C") +
  theme(plot.margin = margin(l = 3, b = 0, r = 0.5, t = 0, unit = "mm"),
        plot.tag = element_text(size = 10, hjust = 1, vjust = 1, color = "white"),
        plot.tag.location = "plot",
        plot.tag.position = c(-0,1))




# Fig 3D (Genus) -----

## Set Up ----

#grab results
obj.w = output$NAC_Response_age_subtypeadj_Taxonomic_Genus

#prep table
prep = da_plt_prep(obj = obj.w, type = "auto", cuts = c(0.05, 0.15),
                   label.crit = c("x < 0.15"), ntop = 10)
#grab mean abundances and add to prep table
#abund_w = get_abund(feature.dat = obj.w$output$test.object$feature.dat, type = "count")
abund_w = norm.fxn(object = obj.w) %>% colMeans()

#abund_w = data.frame(nm = names(abund_w), abundance = abund_w)
abund_w = data.frame(nm = gsub(pattern = "\\.", replacement = "-", x = names(abund_w)), abundance = abund_w)
prep$df = left_join(prep$df, abund_w, by = c("Feature_W" = "nm"))

#prep palette
levels(prep$df$signif_level)
prep$df$signif_level %>% unique()

pal.w = da.pal.master[prep$df$signif_level %>% unique()]

## Plotting ----

set.seed(123)
plt.w = da_plt(obj.prep = prep, type = "auto",
               pt.color = pal.w,
               pt.size = da.pt.size,
               legend.tf = da.legend.tf,
               xlab.size = da.xlab.sz,
               ylab.size = da.ylab.sz, text.size=plt.axis.sz,
               tick.size = da.tick.sz,
               label.size.param = da.label.size.param,
               box.pad.size = da.box.pad.size, 
               point.pad.size = da.point.pad.size,
               max.overlaps.param = da.max.overlaps.param,
               max.iter.param = da.max.iter.param,
               max.time.param = da.max.time.param,
               force.param = da.force.param,
               force.pull.param = da.force.pull.param)+lims(x=c(-.06,.1) )
fig.3d = plt.w 



