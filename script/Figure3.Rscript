# Fig 3B (Chemo Schema) ----



## Set Up ----

### Binary Matrix ----
mat = chemo.df %>% t() %>% data.frame()

### Annotations ----

#put clinical data together quickly
key = clinical_data %>%
  select(ANALYSISID, MCCMID, rcb_score_factor, surrogate_subtype) %>%
  mutate(OLDID = paste0("ONCO", MCCMID)) %>%
  filter(OLDID %in% rownames(chemo.df))
rownames(key) = key$OLDID
key = key[colnames(mat),]
rownames(key) = key$ANALYSISID

#change to Analysis ID
colnames(mat) = key$ANALYSISID

#change column labels
key = key %>% mutate("Subtype" = surrogate_subtype, "RCB" = rcb_score_factor)

#shorten nitrogen mustard
drugkey[which(drugkey$Class == "Nitrogen Mustard Analogue"),"Class"] = "Nitrogen Mustard"

#convert class to factor
lvl.class = unique(drugkey$Class)
drugkey = drugkey %>% mutate(Class = factor(Class, levels = lvl.class))

#replace with +/- for subtypes and convert to factor
key = key %>% 
  mutate(Subtype = as.character(Subtype)) %>%
  mutate(Subtype = case_when(Subtype == "ERpos_HER2neg" ~ "ER+/HER2-",
                             Subtype == "ERpos_HER2pos" ~ "ER+/HER2+",
                             Subtype == "ERneg_HER2pos" ~ "ER-/HER2+",
                             Subtype == "ERneg_HER2neg" ~ "ER-/HER2-"))
key = key %>% mutate(Subtype = factor(Subtype, levels = c("ER+/HER2-", "ER+/HER2+", "ER-/HER2+", "ER-/HER2-")))

### Colors ----

#main colors
main_col_fun = colorRamp2(c(0,1), c("gray90","gray25"))

#annotation colors
subtype.col = c("#8AB833FF", "#C0CF3AFF", "#029676FF", "#4AB5C4FF")
names(subtype.col) = levels(key$Subtype)
rcb.col = ordinal_palette <- c("#FCE4F9","#E8C7F9", "#BEB1FF", "#6551CC")

names(rcb.col) = levels(key$rcb_score_factor)
class.col = c("#DF2E28FF", "#FE801AFF", "#E9BF35FF", "#81BB42FF", "#32C7A9FF", "#4A9BDCFF", "gray50")
names(class.col) = levels(drugkey$Class)

## Legends ----
leg.rcb = Legend(labels = names(rcb.col),
                 title = "RCB Score",
                 legend_gp = gpar(fill = rcb.col),
                 ncol = 1,
                 labels_gp = gpar(fontsize = param.3b.legend.lab.size),
                 grid_height = param.3b.legend.grid.height, 
                 grid_width = param.3b.legend.grid.width,
                 title_gp = gpar(fontsize = param.3b.legend.title.size, fontface = param.3b.legend.title.face),
                 title_gap = param.3b.title.gap)
leg.subtype = Legend(labels = names(subtype.col), 
                     title = "Subtype",
                     legend_gp = gpar(fill = subtype.col),
                     ncol = 1,
                     labels_gp = gpar(fontsize = param.3b.legend.lab.size),
                     grid_height = param.3b.legend.grid.height, 
                     grid_width = param.3b.legend.grid.width,
                     title_gp = gpar(fontsize = param.3b.legend.title.size, fontface = param.3b.legend.title.face),
                     title_gap = param.3b.title.gap)
leg.class = Legend(labels = names(class.col), 
                   title = "Class",
                   legend_gp = gpar(fill = class.col),
                   ncol = 2,
                   labels_gp = gpar(fontsize = param.3b.legend.lab.size),
                   grid_height = param.3b.legend.grid.height, 
                   grid_width = param.3b.legend.grid.width,
                   title_gp = gpar(fontsize = param.3b.legend.title.size, fontface = param.3b.legend.title.face),
                   title_gap = param.3b.title.gap)

leg.list = list(leg.class, leg.rcb, leg.subtype)



## Annotations (plot prep) ----

### Top ----
anno.t = HeatmapAnnotation('RCB Score' = key$RCB,
                           Subtype = key$Subtype,
                           which = "column",
                           col = list(Subtype = subtype.col,
                                      'RCB Score' = rcb.col),
                           simple_anno_size = param.3b.anno.size,
                           annotation_name_gp= gpar(fontsize = param.3b.anno.name.size, fontface = param.3b.anno.name.face),
                           gp = gpar(col = "white"),
                           show_legend = F)

### Left ----
anno.l = HeatmapAnnotation(Class = drugkey$Class,
                           which = "row",
                           col = list(Class = class.col),
                           simple_anno_size = param.3b.anno.size,
                           annotation_name_gp= gpar(fontsize = param.3b.anno.name.size, fontface = param.3b.anno.name.face),
                           gp = gpar(col = "white"),
                           show_legend = F)

## Base Plot ----
plt.base = Heatmap(matrix = mat %>% as.matrix(), 
                   cluster_rows = F,
                   cluster_columns = F,
                   top_annotation = anno.t,
                   left_annotation = anno.l,
                   col = main_col_fun,
                   rect_gp = gpar(col = "white"),
                   width = param.3b.main.width,
                   height = param.3b.main.height,
                   row_names_gp = gpar(fontsize = param.3b.rowname.size),
                   show_column_names = F,
                   show_heatmap_legend = F
)

## Assembly ----
plt.assembled = draw(plt.base,
                     annotation_legend_list = leg.list,
                     annotation_legend_side = "bottom") %>% grid.grabExpr(width = 130/25.4, height = 48/25.4)


## Add Panel Label ----
fig.3b = ggplot() + theme_void() +
  annotation_custom(grob = plt.assembled,xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf)
fig.3b = fig.3b + labs(tag = "B") +
  theme(plot.margin = margin(l = 0, b = 0, r = 0.3, t = 0, unit = "mm"),
