#define functions for doing the insets
get_lims = function(plt, abs.dim = F){
  y.vec = layer_scales(plt)$y$get_limits()
  x.vec = layer_scales(plt)$x$get_limits()
  if(abs.dim == T){
    y.vec = abs(y.vec[1] - y.vec[2])
    x.vec = abs(x.vec[1] - x.vec[2])
  }
  op = list("x" = x.vec, "y" = y.vec)
  return(op)
}

get_window = function(x, y, bl.x, bl.y, plt){
  input.x = get_lims(plt, abs.dim = T)$x
  input.y = get_lims(plt, abs.dim = T)$y
  
  origin.x = get_lims(plt, abs.dim = F)$x[1]
  origin.y = get_lims(plt, abs.dim = F)$y[1]
  
  op = list("xmin" =  (bl.x*input.x) + origin.x,
            "xmax" = (input.x*(bl.x + x)) + origin.x,
            "ymin" = (bl.y*input.y) + origin.y,
            "ymax" = (input.y*(bl.y + y)) + origin.y)
  
  return(op)
}

norm.fxn = function(object){
  obj.tmp = object
  type.tmp = obj.tmp$input$FeatureType
  if(type.tmp == "Taxonomic"){
    print("doing Taxonomic...")
    #get unpruned feature df
    df.tmp = obj.tmp$input$Phyloseq %>% otu_table() %>% data.frame() %>% t()
    rownames(df.tmp) = gsub(pattern = "\\.", replacement = "-", x = rownames(df.tmp))
    
    #grab depth before anything else
    depth.tmp = colSums(df.tmp)
    #winsorize (counts)
    df.tmp = apply(df.tmp, MARGIN = 1, function(x){
      qt = quantile(x, 1-0.03)
      x[x >= qt] <- qt
      return(x)
    }) %>% t()
    
    #TSS (based on unpruned feature matrix)
    df.tmp = t(df.tmp)/depth.tmp
    df.tmp = df.tmp %>% data.frame()
    
  } else if (type.tmp =="Functional"){
    print("doing Functional...")
    df.tmp = obj.tmp$output$test.object$feature.dat
    
    #TSS (based on pruned feature matrix)
    df.tmp = t(df.tmp)/colSums(df.tmp)
    df.tmp = df.tmp %>% data.frame()
    
    #winsorize
    df.tmp = apply(t(df.tmp), MARGIN = 1, function(x){
      qt = quantile(x, 1-0.03)
      x[x >= qt] <- qt
      return(x)
    }) %>% data.frame()
  }
  #square root
  df.tmp = df.tmp^0.5
  
  #select features of interest
  #df.tmp = df.tmp %>% rownames_to_column(var = "SAMPLEID") %>% select(all_of(c("SAMPLEID", features)))
  op = df.tmp
  return(op)
  
}

get_abund = function(feature.dat, type = "count"){
  if(type == "proportion"){
    abund = feature.dat
  }
  if(type ==  "count"){
    abund = t(t(feature.dat)/colSums(feature.dat))
  }
  meanabund  = apply(abund, 1, function(x) mean(x))
  return(meanabund)
}

